{
  "expo": {
    "name": "WHMCS",
    "slug": "whmcs-admin",
    "scheme": "whmcsadmin",
    "version": "0.3.20",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090D14",
    "newArchEnabled": true,
    "android": {
      "package": "com.ontrackdevelopment.command",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 31,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#090D14"
      },
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.ontrackdevelopment.command",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D14",
          "dark": {
            "backgroundColor": "#090D14"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "استخدام البصمة لفتح WHMCS"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
