{
  "expo": {
    "name": "WHMCS",
    "slug": "whmcs-admin",
    "scheme": "whmcsadmin",
    "version": "0.2.8",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080D17",
    "newArchEnabled": true,
    "android": {
      "package": "com.ontrackdevelopment.command",
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#081322"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.ontrackdevelopment.command",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store"
    ],
    "icon": "./assets/icon.png"
  }
}
